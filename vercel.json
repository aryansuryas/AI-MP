{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server.py" },
    { "source": "/:path*",    "destination": "/index.html"  }
  ],
  "functions": {
    "server.py": {
      "maxDuration": 30
    }
  }
}
