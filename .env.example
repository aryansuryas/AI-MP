# ============================================================
# StayWise AI — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# In Vercel, set these via: Dashboard -> Project -> Settings -> Environment Variables

# OPTIONAL: Override API base URL.
# Leave empty to use the default relative path "/api" which works
# automatically both in local dev (proxied via Vite) and on Vercel.
# VITE_API_URL=

# OPTIONAL: Set to "production" or "development"
NODE_ENV=production

